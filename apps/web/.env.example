# ─────────────────────────────────────────────────────────────────────────────
# SkinSystem — Environment Variables
# Copy this file to .env.local and fill in the values for your environment.
# NEVER commit .env.local — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Full URL of your Supabase project (e.g. https://<ref>.supabase.co).
# REQUIRED at build time: next.config.js derives the image-optimization
# hostname from this value. A missing or malformed URL will fail the build.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_APPLE_ENABLED=

# Supabase anonymous / publishable key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service-role key — server-only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth providers ────────────────────────────────────────────────────────────
# Set to `true` to show "Sign in with Apple". Requires external setup first:
# Apple Developer Program → Services ID, key and redirect URIs → Apple provider
# in Supabase Auth. Any value other than exactly `true` keeps the button hidden.
  NEXT_PUBLIC_SUPABASE_APPLE_ENABLED=

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Drizzle ORM (server-only)
DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# ── App ───────────────────────────────────────────────────────────────────────
# Root domain for multi-tenant subdomain routing (e.g. lvh.me in dev)
NEXT_PUBLIC_BASE_DOMAIN=lvh.me

# Full base URL of the app (used for absolute links, OAuth redirects, etc.)
NEXT_PUBLIC_BASE_URL=http://lvh.me:3000

# ── Upstash Redis ─────────────────────────────────────────────────────────────
# Used for 5-min reservation locks and session cache
UPSTASH_REDIS_REST_URL=https://<your-instance>.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ── Stripe ────────────────────────────────────────────────────────────────────
# Platform-level Stripe keys (Connect orchestrator account).
#
# Architecture: Stripe Connect Standard. Each specialist's org gets its own
# full Stripe account (stripe.accounts.create({ type: 'standard' })) and
# completes onboarding through Stripe's hosted Account Links flow — the app
# never touches card data and never loads Stripe.js/Elements on the client,
# so no publishable key is required. Checkout also uses Stripe's hosted
# Checkout Sessions, redirecting to the specialist's connected account via
# payment_intent_data.transfer_data.destination.
#
# In production, a connected account is mandatory before any booking can
# charge a customer — see allowsDirectPlatformCharge() in
# src/shared/lib/stripe-policy.ts, which fails hard if STRIPE_SECRET_KEY is
# ever a test key (sk_test_) while NODE_ENV=production.
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
# Platform fee in basis points (e.g. 200 = 2 %)
STRIPE_PLATFORM_FEE_BPS=200
